{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install && npm install --prefix ../backend",
  "functions": {
    "api/[[...path]].js": {
      "maxDuration": 10,
      "includeFiles": "../backend/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 6 * * *"
    }
  ]
}
