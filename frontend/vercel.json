{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm ci || npm install && (npm ci --prefix ../backend || npm install --prefix ../backend)",
  "functions": {
    "api/health.js": {
      "maxDuration": 10
    },
    "api/[...path].js": {
      "maxDuration": 10,
      "includeFiles": "../backend/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 6 * * *"
    }
  ]
}
